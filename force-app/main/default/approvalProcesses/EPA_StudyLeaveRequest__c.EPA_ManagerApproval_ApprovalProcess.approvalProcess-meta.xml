<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>EPA_Apprentice__c</field>
        <field>EPA_StartDate__c</field>
        <field>EPA_EndDate__c</field>
        <field>EPA_Category__c</field>
        <field>EPA_CalculatedBusinessDays__c</field>
        <field>EPA_Status__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <description>Routes to the submitter direct line manager via the User Manager hierarchy</description>
        <label>Manager Approval</label>
        <name>Manager_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <description>Single-level manager approval for study leave requests. Routes to the submitter manager. No escalation or timeout.</description>
    <emailTemplate>EPA_StudyLeave/EPA_ManagerSubmissionNotification_EmailTemplate</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <entryCriteria>
        <criteriaItems>
            <field>EPA_StudyLeaveRequest__c.EPA_Status__c</field>
            <operation>equals</operation>
            <value>Pending</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>EPA_StatusApproved_FieldUpdate</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>EPA_ApprenticeApprovalNotification_EmailAlert</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>EPA_StatusRejected_FieldUpdate</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>EPA_ApprenticeRejectionNotification_EmailAlert</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>EPA Manager Approval</label>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
