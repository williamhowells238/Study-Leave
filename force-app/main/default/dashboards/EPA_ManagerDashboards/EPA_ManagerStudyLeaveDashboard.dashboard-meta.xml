    <dashboardType>LoggedInUser</dashboardType>
    <description>Manager dashboard showing study leave requests for direct-report apprentices. Dynamic Dashboard scoped to the logged-in manager.</description>
    <leftSection>
        <columnSize>Medium</columnSize>
        <components>
            <autoselectColumnsFromReport>true</autoselectColumnsFromReport>
            <chartAxisRange>Auto</chartAxisRange>
            <componentType>Donut</componentType>
