            <header>Total Approved Days</header>
            <indicatorHighColor>#54C893</indicatorHighColor>
            <indicatorLowColor>#E74C3C</indicatorLowColor>
            <indicatorMiddleColor>#F5A623</indicatorMiddleColor>
            <metricLabel>Total Approved Days</metricLabel>
            <report>EPA_StudyLeaveReports/EPA_StudyLeaveByApprentice</report>
            <title>Total Approved Days</title>
        </components>
    </middleSection>
    <rightSection>
        <columnSize>Medium</columnSize>
