<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>EPA_ApprenticeApprovalNotification_EmailAlert</fullName>
        <description>Sends the approval email notification to the apprentice when the manager approves the study leave request</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>EPA_StudyLeave/EPA_ApprenticeApprovalNotification_EmailTemplate</template>
    </alerts>
    <alerts>
        <fullName>EPA_ApprenticeRejectionNotification_EmailAlert</fullName>
        <description>Sends the rejection email notification to the apprentice when the manager rejects the study leave request</description>
        <protected>false</protected>
        <recipients>
            <type>owner</type>
        </recipients>
        <senderType>CurrentUser</senderType>
        <template>EPA_StudyLeave/EPA_ApprenticeRejectionNotification_EmailTemplate</template>
    </alerts>
    <fieldUpdates>
        <fullName>EPA_StatusApproved_FieldUpdate</fullName>
        <description>Sets the Status field to Approved when the manager approves the study leave request</description>
        <field>EPA_Status__c</field>
        <literalValue>Approved</literalValue>
        <name>EPA Status Approved Field Update</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
    <fieldUpdates>
        <fullName>EPA_StatusRejected_FieldUpdate</fullName>
        <description>Sets the Status field to Rejected when the manager rejects the study leave request</description>
        <field>EPA_Status__c</field>
        <literalValue>Rejected</literalValue>
        <name>EPA Status Rejected Field Update</name>
        <notifyAssignee>false</notifyAssignee>
        <operation>Literal</operation>
        <protected>false</protected>
    </fieldUpdates>
</Workflow>
