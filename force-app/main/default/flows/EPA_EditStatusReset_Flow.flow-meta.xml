<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <environments>Default</environments>
    <interviewLabel>EPA Edit Status Reset {!$Flow.CurrentDateTime}</interviewLabel>
    <label>EPA Edit Status Reset</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Fields_Changed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EPA_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Approved</stringValue>
            </value>
        </filters>
        <object>EPA_StudyLeaveRequest__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <decisions>
        <name>Check_Fields_Changed</name>
        <label>Check Fields Changed</label>
        <locationX>176</locationX>
        <locationY>200</locationY>
        <defaultConnectorLabel>No Relevant Changes</defaultConnectorLabel>
        <rules>
            <name>Fields_Changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EPA_StartDate__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.EPA_StartDate__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EPA_EndDate__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.EPA_EndDate__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EPA_Category__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.EPA_Category__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Reset_Status_To_Pending</targetReference>
            </connector>
            <label>Fields Changed</label>
        </rules>
    </decisions>
    <assignments>
        <name>Reset_Status_To_Pending</name>
        <label>Reset Status To Pending</label>
        <locationX>176</locationX>
        <locationY>400</locationY>
        <assignmentItems>
            <assignToReference>$Record.EPA_Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Pending</stringValue>
            </value>
        </assignmentItems>
    </assignments>
</Flow>
